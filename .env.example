# Copy this file to .env.local and fill in the values from Supabase.
# Never paste secret keys into client-side code or commit .env.local to Git.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional email notifications. The website still stores enquiries in Supabase if these are blank.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
SALON_NOTIFICATION_EMAIL=
